# ============================================================
# Bali Things To Do — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database ---
# Development (SQLite, local file)
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) example:
# DATABASE_URL="postgresql://user:password@host:5432/balithingstodo?schema=public"

# --- Application ---
# Absolute public URL of this environment (used in links, sitemap, emails)
APP_URL="http://localhost:3000"
# Secret used to sign session cookies & password-reset tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-64-byte-random-hex"
# Set to "production" in production
NODE_ENV="development"

# --- Email (SMTP). Leave empty to log emails to the outbox table instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Bali Things To Do <no-reply@balithingstodo.net>"

# --- Payments. Leave empty to run in "manual/bank transfer" mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Deployment / integrations (optional) ---
# GITHUB_TOKEN is used only by CI/CD secrets, never stored here.
# GOOGLE_ANALYTICS_ID / GTM are configured in Admin → SEO at runtime.
